# Copie para .env na RAIZ do repositório (já está no .gitignore).
# Formato: NOME=valor  (sem aspas, sem espaço, sem rótulo antes da chave, sem comentário na mesma linha).
# Deixe vazio o que não tiver. Confira com: python src/checar_env.py --testar
# Chaves nunca vão para o chat, Teams ou commit.

# OmniRoute (opcional; se configurado, é o primeiro a ser usado)
OMNIROUTE_BASE_URL=
OMNIROUTE_API_KEY=

# Groq: console.groq.com/keys (começa com gsk_)
GROQ_API_KEY=
# Google AI Studio: aistudio.google.com/apikey
GOOGLE_API_KEY=
# OpenRouter: openrouter.ai/keys (começa com sk-or-)
OPENROUTER_API_KEY=
# NVIDIA: build.nvidia.com (começa com nvapi-)
NVIDIA_API_KEY=
# Z.ai: os GLM pagos precisam de saldo
ZAI_API_KEY=

# Supabase, papel fortuna_leitura, terminando em ?sslmode=require
FORTUNA_DSN=
# Token do time na API do bureau
FORTUNA_BUREAU_TOKEN=

# Conselho de LLMs (opcional): provedor:modelo separados por vírgula
CONSELHO_MODELOS=groq:openai/gpt-oss-120b,google:gemini-3.5-flash,openrouter:openrouter/free
