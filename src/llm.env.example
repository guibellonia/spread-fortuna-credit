# Copie para um .env (NÃO versionar) ou exporte no terminal. Chaves nunca vão para o git.

# 1) Principal: OmniRoute (faz o fallback entre os modelos configurados nele)
OMNIROUTE_BASE_URL=http://localhost:20128/v1   # confirme a porta/endereço do OmniRoute do time
OMNIROUTE_API_KEY=
OMNIROUTE_MODELS=hermes                         # nome do modelo/combo como está no OmniRoute

# 2) Rede de segurança: provedores diretos, usados só se o OmniRoute cair (deixe vazio o que não tiver)
ZAI_API_KEY=
NVIDIA_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
# OLLAMA_BASE_URL=http://localhost:11434/v1   # modelo local, sem chave
# <PROVEDOR>_MODELS=...                        # sobrescreve os ids padrão de src/llm.py (confira no painel)
# LLM_ORDEM=omniroute,zai,google,nvidia,openrouter,groq,ollama

# Conselho de LLMs: membros explícitos (provedor:modelo), todos podem passar pelo OmniRoute
CONSELHO_MODELOS=omniroute:hermes,omniroute:glm-4.6,omniroute:gemini-2.5-flash,omniroute:nemotron
